ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meez_menu
REDIS_URL=redis://localhost:6379/0
MENU_CACHE_TTL_SECONDS=60

JWT_SECRET=replace-with-long-random-secret-min-32-chars
JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:8080,http://localhost:8081
PUBLIC_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# S3 (production)
# STORAGE_BACKEND=s3
# S3_BUCKET=meez-uploads
# S3_REGION=auto
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL_PREFIX=https://cdn.example.com

RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_DEFAULT=120/minute
