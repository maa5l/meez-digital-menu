{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["index.js", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "src/main.tsx",
    "src/index.css",
    "src/vite-env.d.ts",
    "src/plugins",
    "index.html",
    "vite.config.ts",
    "tailwind.config.ts",
    "tsconfig.app.json"
  ]
}
