#   2) شغّل npm run dev على PC (منفذ 8080)
#   3) على Mac في meez-app/.env.local:
# VITE_MENU_WEB_URL=http://192.168.1.50:8080
# VITE_PUBLIC_SITE_HOST=192.168.1.50:8080
