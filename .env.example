# Frontend (Vite — prefix VITE_)
VITE_APP_URL=http://localhost:8080
# VITE_IPAD_TRIAL_MODE=true
# VITE_PUBLIC_SITE_HOST=meez.com
# عند وجود مفاتيح Supabase أدناه يُستخدم Auth الحقيقي تلقائياً
VITE_ENABLE_MOCK_AUTH=false
# VITE_FORCE_SUPABASE_AUTH=true
# VITE_USE_LOCAL_MOCK_AUTH=true
VITE_LOG_LEVEL=debug

# دعم العملاء (صفحة انتهاء الاشتراك)
# VITE_SUPPORT_EMAIL=support@meez.app
# VITE_SUPPORT_WHATSAPP=966500000000

# Supabase (Dashboard → Settings → API → anon public)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# تطبيق الكشk (meez-app) — انسخ مفاتيح Supabase إلى meez-app/.env.local

# Express health server (اختياري — server/.env)
# PORT=3001
# CORS_ORIGIN=http://localhost:8080

# بعد تطبيق migrations شغّل supabase/scripts/bootstrap-admin.sql لإنشاء أول مدير
