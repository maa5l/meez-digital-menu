{
  "name": "meez-digital-menu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:kiosk": "npm run dev --prefix meez-app",
    "eas:android:preview": "npm exec --prefix meez-app -- eas-cli@latest build --platform android --profile preview",
    "eas:ios:preview": "npm exec --prefix meez-app -- eas-cli@latest build --platform ios --profile preview",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link --project-ref feorprugthydhyytvebe",
    "supabase:db:push": "supabase db push",
    "supabase:db:pull": "supabase db pull",
    "supabase:types": "supabase gen types typescript --project-id feorprugthydhyytvebe > src/lib/supabase/database.types.ts",
    "supabase:auth:push": "node scripts/push-auth-email-templates.mjs",
    "supabase:config:push": "supabase config push --project-ref feorprugthydhyytvebe --yes",
    "test:otp": "node scripts/test-otp-send.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
